@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
      var tokens = antiforgery.GetAndStoreTokens(Context);
}
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="description" content="@ViewData["MetaDescription"]"/>

<title>@ViewData["Title"] - GestorInventario</title>

<!-- CSRF token para AJAX -->
<meta name="csrf-token" content="@tokens.RequestToken"/>

<!-- DNS Prefetch para Google Fonts -->
<link rel="dns-prefetch" href="https://fonts.gstatic.com">

<!-- Bootstrap CSS (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
      integrity="sha384-0EvHe/X+R7Yk6jvGQkFqnhl5Vn4qFhc7O6gDQ6D7fF0vRJYkR5h2qT+E4qpFZhM" crossorigin="anonymous">

<!-- Bootstrap Icons (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Preload de fuentes WOFF2 -->
<link rel="preload" href="https://fonts.gstatic.com/s/inter/v13/UcC73FwrK3iLTeHuS_fvQtMwCp50KnMa1ZL7.woff2"
      as="font" type="font/woff2" crossorigin>

<!-- Preload de CSS local -->
<link rel="preload" href="~/lib/bootstrap/dist/css/bootstrap.min.css" as="style" onload="this.rel='stylesheet'"
      asp-append-version="true">
<link rel="preload" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" as="style"
      onload="this.rel='stylesheet'" asp-append-version="true">
<link rel="preload" href="~/css/site.css" as="style" onload="this.rel='stylesheet'" asp-append-version="true">

<!-- Fallback para navegadores sin JS -->
<noscript>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</noscript>