@inject GestorInventario.Application.Interfaces.Web.ICurrentUserAccessor CurrentUser
@{
    var isAdminOrUser = CurrentUser.IsAdminOrUser();
}
<!DOCTYPE html>
<html lang="en">
<head>
   <partial name="Partials/_Head"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-dark">
        <div class="container-fluid">
            <!-- 1. Logo  -->
            <partial name="Partials/_NavbarBrand" />

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- 2. Menú principal de navegación -->
                <partial name="Partials/_NavbarMenu" />

                <ul class="navbar-nav ms-auto">
                    <!-- 3. Operaciones PayPal (Si aplica) -->
                    @if (isAdminOrUser)
                    {
                        <partial name="Partials/_NavbarOperations" />
                    }

                    <!-- 4. Menú de Usuario y Notificaciones -->
                    <partial name="Partials/_NavbarUser" />
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="container">
    @RenderBody()
</main>

<footer class="footer text-center">
    <div class="container">
        © 2025 - GestorInventario - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
    </div>
</footer>

<!-- Scripts con defer para no bloquear rendering -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ENjdO4Dr2bkBIFxQpeoFQmQznMR64s5FjtpVZBjVUXx0f5i5mAGsQcf5D4yH6rZ7" crossorigin="anonymous"
        defer></script>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
<script src="~/js/conteo-notificaciones.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>