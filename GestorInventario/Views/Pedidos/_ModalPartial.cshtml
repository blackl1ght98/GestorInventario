
@model List<string>

<!-- Modal Agregar Info Envío -->
<div class="modal fade" id="agregarEnvioModal" tabindex="-1" aria-labelledby="agregarEnvioModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="agregarEnvioModalLabel">Agregar Información de Envío</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="modal-body">
                   
                    <div id="envioResult" class="alert d-none" role="alert"></div>
                </div>
                <form id="agregarEnvioForm" method="post" asp-controller="Envios" asp-action="AgregarInfoEnvio">
                    <input type="hidden" name="PedidoId" id="pedidoIdInput" />

                    <div class="mb-3">
                        <label class="form-label">Transportista</label>
                        <select class="form-select" name="carrier" id="carrierSelect" required>
                            <option value="">Seleccione transportista...</option>
                            @foreach (var carrier in Model)
                            {
                                <option value="@carrier">@carrier</option>
                            }
                        </select>
                       
                    </div>
                   
                </form>
                <div id="loadingMessageEnvio" class="text-center mt-3 d-none">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2">Procesando envío...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="confirmAgregarEnvioBtn">Guardar Información</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reembolso -->
<div class="modal fade" id="confirmRefundTotalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Confirmar Reembolso Total</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="refundText" class="mb-3">¿Estás seguro de que deseas reembolsar el pedido completo?</p>
                <div id="refundResult" class="alert d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-danger" id="confirmRefundTotalBtn">Sí, Reembolsar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal CancelarPedido -->
<div class="modal fade" id="confirmCancelarModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Cancelar Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="cancelText" class="mb-3">¿Esta seguro que desea cancelar el pedido?</p>
                <div id="cancelResult" class="alert d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-danger" id="confirmCancelBtn">Sí, Cancelar</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Confirmar Entrega -->
<div class="modal fade" id="confirmEntregaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Cancelar Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="entregaText" class="mb-3">¿Esta seguro que desea cancelar el pedido?</p>
                <div id="entregaResult" class="alert d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-danger" id="confirmEntregaBtn">Sí, Confirmar entrega</button>
            </div>
        </div>
    </div>
</div>