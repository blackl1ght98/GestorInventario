@using GestorInventario.Extensions
@model GestorInventario.Application.DTOS.Pedidos.PedidoDtoViewModel

<div class="col">
    <div class="card h-100 border-0 shadow-sm hover-card">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="card-title text-primary mb-0">Pedido #@Model.NumeroPedido</h5>
                <span class="badge bg-@Model.BadgeColor fs-6">
                    @Model.EstadoPedido
                </span>
            </div>

            <p class="card-text mb-1">
                <strong>Fecha:</strong> @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")
            </p>
            <p class="card-text mb-1">
                <strong>Cliente:</strong> @Model.NombreCompleto
            </p>

            @if (!string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <p class="card-text mb-1">
                    <strong>Seguimiento:</strong> @Model.TrackingNumber
                </p>
                <p class="card-text mb-3">
                    <strong>Transportista:</strong> @Model.Transportista
                </p>
            }

            <div class="mt-auto pt-3">
                <div class="d-grid gap-2">
                    <a asp-action="DetallesPedido" asp-route-id="@Model.Id"
                       class="btn btn-outline-primary @(Model.DetallePedidos?.Any() == true ? "" : "d-none")">
                        <i class="bi bi-eye me-2"></i>Ver Detalles
                    </a>

                    @if (User.IsAdministrador())
                    {
                        <div class="btn-group" role="group">
                            @{
                                var captura = Model.PalPaymentCaptures?.FirstOrDefault();
                            }

                            @if (captura != null)
                            {
                                <button type="button"
                                        class="btn btn-outline-warning flex-fill refund-total-btn"
                                        data-pedido-id="@Model.Id"
                                        data-currency="@Model.Currency"
                                        data-payment-id="@captura.PaymentId"
                                        @(Model.EsRembolsado ? "disabled" : "")>
                                    Rembolsar
                                </button>
                            }
                            <button type="button"
                                    class="btn btn-outline-warning flex-fill cancel-btn"
                                    data-pedido-id="@Model.Id"
                                    @(Model.EstadoNoCancelable || Model.EsCarrito ? "disabled" : "")>
                                Cancelar
                            </button>
                            <button type="button"
                                    class="btn btn-outline-warning flex-fill entrega-btn"
                                    data-pedido-id="@Model.Id"
                                    disabled="@Model.BloquearEntrega">
                                Confirmar entrega
                            </button>
                        </div>

                        <button class="btn btn-success activate-action-button mt-2 envio-btn"
                                data-pedido-id="@Model.Id"
                                title="Agregar información de envío"
                                @(Model.EsCarrito || Model.EsCancelado ? "disabled" : "")>
                            <i class="bi bi-truck me-2"></i>Agregar Envío
                        </button>

                        <div class="d-grid gap-2 mt-2">
                            @if (captura != null)
                            {
                                <a asp-action="DetallesPagoEjecutado"
                                   asp-controller="Payment"
                                   asp-route-paymentId="@captura.PaymentId"
                                   asp-route-pedidoId="@Model.Id"
                                   class="btn btn-outline-info">
                                    Detalles del Pago
                                </a>
                                <a asp-action="Sincronizar"
                                   asp-controller="Payment"
                                   asp-route-paymentId="@captura.PaymentId"
                                   asp-route-pedidoId="@Model.Id"
                                   class="btn btn-outline-info">
                                    Sincronizar
                                </a>
                            }
                            else
                            {
                                <a asp-action="ReintentarPago"
                                   asp-controller="Payment"
                                   asp-route-pedidoId="@Model.Id"
                                   class="btn btn-sm btn-outline-primary @(Model.EsCanceladoOCarrito ? "disabled" : "")"
                                   aria-disabled="@(Model.EsCanceladoOCarrito ? "true" : "false")"
                                   style="@(Model.EsCanceladoOCarrito ? "pointer-events: none; opacity: 0.65;" : "")">
                                    <i class="fas fa-credit-card me-1"></i> Completar pago
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-warning flex-fill cancel-btn"
                                    data-pedido-id="@Model.Id"
                                    @(Model.EstadoNoCancelable || Model.EsCarrito ? "disabled" : "")>
                                Cancelar
                            </button>
                            <button type="button"
                                    class="btn btn-outline-warning flex-fill entrega-btn"
                                    data-pedido-id="@Model.Id"
                                    disabled="@(Model.EsCancelado || Model.EsEnviado ? "disabled" : "")">
                                Confirmar entrega
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>