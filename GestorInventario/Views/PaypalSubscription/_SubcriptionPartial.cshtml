@model GestorInventario.Application.DTOS.SubcritionDtoViewModel


<div class="col">
    <div class="card h-100 border-0 shadow-sm hover-card transition-all">
        <div class="card-body p-4 d-flex flex-column">

            <!-- ID de Suscripción -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="card-title text-primary mb-0 fw-semibold">
                    @Model.SubscriptionId
                </h5>

            </div>

            <!-- Información -->
            <div class="mb-4">
                <p class="mb-2">
                    <strong>Estado:</strong>
                    <span class="text-muted">@Model.Status</span>
                </p>
                <p class="mb-2">
                    <strong>Plan:</strong>
                    <span class="text-muted">@Model.PlanId</span>
                </p>
                <p class="mb-2">
                    <strong>Suscriptor:</strong>
                    @Model.SubscriberName
                </p>
                <p class="mb-2">
                    <strong>Email:</strong>
                    <a href="mailto:@Model.SubscriberEmail" class="text-decoration-none">@Model.SubscriberEmail</a>
                </p>
                <p class="mb-2">
                    <strong>Payer ID:</strong>
                    <span class="text-muted small">@Model.PayerId</span>
                </p>
                @if (Model.TrialIntervalCount > 0)
                {
                    <p class="mb-0">
                        <strong>Período de prueba:</strong>
                        <span class="text-success">@Model.TrialIntervalCount días</span>
                    </p>
                }
            </div>

            <!-- Acciones (solo Admin) -->
            @if (User.IsInRole("Administrador"))
            {
                <div class="mt-auto pt-3 border-top">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="DetallesSuscripcion" asp-controller="PaypalSubscription"
                           asp-route-id="@Model.SubscriptionId"
                           class="btn btn-outline-primary flex-fill btn-sm">
                            <i class="bi bi-eye me-1"></i> Detalles
                        </a>

                        <button type="button"
                                class="btn btn-warning btn-sm flex-fill btn-suspend-suscripcion"
                                data-id="@Model.SubscriptionId"
                                data-bs-toggle="tooltip"
                                title="Suspender suscripción">
                            <i class="bi bi-pause-circle"></i> Suspender
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm flex-fill btn-cancel-suscripcion"
                                data-id="@Model.SubscriptionId"
                                data-bs-toggle="tooltip"
                                title="Cancelar suscripción">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </button>

                        <button type="button"
                                class="btn btn-success btn-sm flex-fill btn-activar-suscripcion"
                                data-id="@Model.SubscriptionId"
                                data-bs-toggle="tooltip"
                                title="Activar suscripción">
                            <i class="bi bi-play-circle"></i> Activar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>