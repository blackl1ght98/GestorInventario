@model GestorInventario.Application.DTOS.Carrito.CarritoCardViewmodelDto

<div class="col-12">
    <div class="card shadow-sm border-0 hover-card">
        <div class="row g-0">
            <div class="col-md-3">
                <img src="@Model.Imagen"
                     class="img-fluid h-100 object-fit-cover rounded-start"
                     alt="@Model.NombreProducto"
                     style="max-height: 180px;">
            </div>
            <div class="col-md-9">
                <div class="card-body d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title">@Model.NombreProducto</h5>
                        <span class="fw-bold text-success fs-5">@Model.Precio.ToString("C")</span>
                    </div>
                    <p class="text-muted small">@Model.Descripcion</p>
                    <p class="text-muted small">Proveedor: @Model.NombreProveedor</p>

                    <div class="mt-auto d-flex justify-content-between align-items-end">
                        <div class="d-flex align-items-center gap-3">
                            <form asp-action="Decrementar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.IdDetallePedido" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-dash"></i></button>
                            </form>
                            <span class="fw-bold fs-5">@Model.Cantidad</span>
                            <form asp-action="Incrementar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.IdDetallePedido" />
                                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus"></i></button>
                            </form>
                        </div>

                        <div class="text-end">
                            <small class="text-muted">Total</small>
                            <h5 class="mb-0">@Model.Total</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light border-0 text-end">
            <form asp-action="EliminarProductoCarrito" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdDetallePedido" />
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </form>
        </div>
    </div>
</div>
