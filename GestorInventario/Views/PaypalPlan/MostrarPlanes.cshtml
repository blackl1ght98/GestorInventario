@using GestorInventario.ViewModels.Paypal

@model PayPalPlansIndexViewModel
@{
    ViewData["Title"] = "Planes de Suscripción de PayPal";
}

<div class="container mt-5">
    <div class="text-center mb-5 animate-fade-in">
        <h2 class="text-secondary fw-bold">
            <i class="bi bi-star-fill me-2"></i>Planes de Suscripción de PayPal
        </h2>
        <p class="text-muted fs-5">Explora nuestros planes y suscríbete al que mejor se adapte a tus necesidades.</p>
    </div>

    @if (!Model.Planes.Any())
    {
        <div class="alert alert-warning text-center rounded-3 py-4">
            <i class="bi bi-exclamation-triangle me-2 fs-4"></i>
            No hay planes de suscripción disponibles en este momento.
        </div>
    }
    else
    {
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (User.IsInRole("Administrador"))
        {
            <div class="text-center mb-4">
                <button id="btnSincronizar" class="btn btn-outline-primary btn-lg" data-total-paginas="@Model.TotalPaginas" data-pagina-actual="@Model.PaginaActual">
                    <i class="bi bi-arrow-repeat me-2"></i>Sincronizar con PayPal
                </button>
            </div>

           <partial name="_SyncModalPartial"/>
        }

        <div class="row g-4">
            @foreach (var plan in Model.Planes)
            {
                <partial name="_PlanesPartial" model="plan"/>
            }
        </div>

        <!-- Paginación -->
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                @foreach (var pagina in Model.Paginas)
                {
                    <li class="page-item @(pagina.Habilitada ? "" : "disabled") @(pagina.Activa ? "active" : "")">
                        <a class="page-link px-4 py-2 mx-1 rounded-pill"
                           href="@Url.Action("MostrarPlanes", new { pagina = pagina.Pagina, cantidadAMostrar = Model.CantidadAMostrar })">
                            @pagina.Texto
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<partial name="_UpdatePriceModalPartial"/>

@section Scripts {
    <script src="~/js/planes.js" asp-append-version="true"></script>
    <script src="~/js/sincronizarPlanes.js" asp-append-version="true"></script>

}