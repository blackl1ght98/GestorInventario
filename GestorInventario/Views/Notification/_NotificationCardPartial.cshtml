@model GestorInventario.Application.DTOS.Notification.NotificationDtoViewmodel

<div class="col">
    <div class="card h-100 shadow-sm @(Model.Leida ? "" : "border-primary")">

        <div class="card-header d-flex justify-content-between align-items-center
                        @(Model.Leida ? "bg-light text-muted" : "bg-primary text-white")">
                        <span class="badge @Model.BadgeCssClass">
                            @Model.Tipo
                        </span>
            @if (!Model.Leida)
            {
                <span class="badge bg-danger">Nueva</span>
            }
        </div>

        <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-2">@Model.Titulo</h5>
            <p class="card-text text-muted mb-3">@Model.Mensaje</p>
        </div>

        <div class="card-footer bg-transparent d-flex
                        justify-content-between align-items-center">
            <small class="text-muted">
                <i class="bi bi-clock"></i>
                @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
            </small>
            @if (!Model.Leida)
            {
                <form asp-action="MarcarLeida" asp-route-id="@Model.Id"
                      method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-check2"></i> Marcar leída
                    </button>
                </form>
            }
        </div>
    </div>
</div>