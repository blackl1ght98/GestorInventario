@model GestorInventario.Application.DTOS.Role.RoleUserDtoViewmodel

<div class="col">
    <div class="card h-100 border-0 shadow-sm hover-card transition-all">
        <div class="card-body p-4 d-flex flex-column">

            <!-- Nombre del Usuario -->
            <h5 class="card-title fw-semibold text-primary mb-3">
                <i class="bi bi-person me-2"></i>@Model.NombreCompleto
            </h5>

            <!-- Información -->
            <div class="mb-4">
                <p class="mb-2">
                    <i class="bi bi-envelope text-muted me-2"></i>
                    <strong>Email:</strong> @Model.Email
                </p>
                <p class="mb-0">
                    <i class="bi bi-person-badge text-muted me-2"></i>
                    <strong>Rol actual:</strong>
                    <span class="badge bg-primary">@Model.NombreRol</span>
                </p>
            </div>

            <!-- Acción -->
            <div class="mt-auto">
                <button class="btn btn-primary w-100 change-role-button"
                        data-user-id="@Model.UsuarioId">
                    <i class="bi bi-gear me-2"></i>Cambiar Rol
                </button>
            </div>
        </div>
    </div>
</div>