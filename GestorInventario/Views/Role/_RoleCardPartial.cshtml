@model GestorInventario.Application.DTOS.Role.RoleCardViewModel

<div class="col">
    <div class="card h-100 border-0 shadow-sm hover-card transition-all">
        <div class="card-body p-4 d-flex flex-column">

            <!-- Nombre del Rol -->
            <div class="d-flex align-items-center mb-4">
                <i class="bi bi-shield-lock fs-3 text-primary me-3"></i>
                <h5 class="card-title fw-semibold text-primary mb-0">@Model.Nombre</h5>
            </div>

            <!-- Información -->
            <div class="mb-4">
                <p class="mb-3">
                    <i class="bi bi-people text-muted me-2"></i>
                    <strong>Usuarios con este rol:</strong>
                    <span class="badge bg-secondary fs-6 ms-2">@(Model.NumeroUsuarios)</span>
                </p>
            </div>

            <!-- Acción -->
            <div class="mt-auto">
                <a asp-action="VerUsuariosPorRol" asp-route-id="@Model.RoleId"
                   class="btn btn-primary w-100">
                    <i class="bi bi-people me-2"></i>Ver Usuarios Asociados
                </a>
            </div>
        </div>
    </div>
</div>